.env
.env.local
.env.*.local
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Frontend (Node / Vite)
frontend/node_modules/
node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vector Database locks & temporary state
data/qdrant/.lock

# Datasets exceeding GitHub's 100MB hard limit
